#!/usr/bin/env bash
set -euo pipefail
root=$(git rev-parse --show-toplevel)
test "$(uname -m)" = x86_64
command -v docker >/dev/null
command -v node >/dev/null
command -v python3 >/dev/null
if ! docker buildx version 2>/dev/null | rg -q 'v0\.37\.1\b'; then
  tmp=$(mktemp -d)
  trap 'rm -rf "$tmp"' EXIT
  curl -fsSL https://github.com/docker/buildx/releases/download/v0.37.1/buildx-v0.37.1.linux-amd64 -o "$tmp/buildx"
  printf '9447199cdb435f25880548343c128a4b6650e8891ee598905d8d29d39a8e359b  %s\n' "$tmp/buildx" | sha256sum --check
  mkdir -p "$HOME/.docker/cli-plugins"
  install -m 755 "$tmp/buildx" "$HOME/.docker/cli-plugins/docker-buildx"
fi
npm ci --prefix "$root/prototype" --ignore-scripts
echo 'Offline dependencies ready. No account authentication or deployment performed.'
