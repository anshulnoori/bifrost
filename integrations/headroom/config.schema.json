{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Experimental Headroom plugin configuration",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "enabled": {"type": "boolean", "default": false},
    "embedding_proxy_enabled": {"type": "boolean", "default": false},
    "scope": {"enum": ["gateway", "restricted"]},
    "project_id": {"type": "string"},
    "virtual_key_id": {"type": "string"},
    "endpoint": {"type": "string", "format": "uri"},
    "modal_app": {"type": "string", "description": "Private Modal app; mutually exclusive with endpoint and token_env."},
    "modal_environment": {"type": "string", "default": "main"},
    "token_env": {"type": "string"},
    "modal_key_env": {"type": "string"},
    "modal_secret_env": {"type": "string"},
    "scope_key_env": {"type": "string"},
    "failure_policy": {"enum": ["open", "closed"], "default": "open"},
    "timeout_ms": {"type": "integer", "minimum": 1, "maximum": 30000, "default": 2000},
    "max_body_bytes": {"type": "integer", "minimum": 1024, "maximum": 16777216, "default": 4194304},
    "min_text_bytes": {"type": "integer", "minimum": 1, "default": 1024},
    "ccr": {"const": false},
    "metrics_address": {"type": "string"},
    "metrics_token_env": {"type": "string"},
    "cost_ledger_path": {"type": "string"},
    "retention_seconds": {"type": "integer", "minimum": 0, "maximum": 86400, "default": 0}
  }
}
