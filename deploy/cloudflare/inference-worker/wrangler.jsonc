{
  "name": "bifrost-inference",
  "main": "index.ts",
  "compatibility_date": "2026-09-23",
  "compatibility_flags": ["enable_request_signal"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "observability": { "enabled": false },
  "vars": {
    "INFERENCE_ORIGIN": "https://inference.invalid",
    "ADMIN_ORIGIN": "https://admin.invalid",
    "EMERGENCY_DISABLE": "true",
    "ACCESS_ISSUER": "https://unconfigured.cloudflareaccess.com",
    "ACCESS_AUD": ""
  },
  "containers": [{ "class_name": "BifrostContainer", "image": "../container/Dockerfile", "image_build_context": "../../..", "instance_type": "standard-1", "max_instances": 1 }],
  "durable_objects": { "bindings": [{ "name": "BIFROST", "class_name": "BifrostContainer" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["BifrostContainer"] }]
}
