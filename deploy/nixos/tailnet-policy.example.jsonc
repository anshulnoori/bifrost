// Merge and test in the existing tailnet policy. Do not replace it wholesale.
// Existing broad grants can still allow other members to access this node.
{
  "tagOwners": {
    "tag:bifrost": ["autogroup:admin"],
    // Residential egress proxy, created by the homelab Tailscale operator.
    "tag:proxy": ["tag:k8s-operator"]
  },
  "grants": [
    {
      "src": ["autogroup:admin"],
      "dst": ["tag:bifrost"],
      "ip": ["tcp:22"]
    },
    {
      "src": ["autogroup:admin"],
      "dst": ["svc:ai"],
      "ip": ["tcp:443", "tcp:8443"]
    },
    {
      // Bifrost hosts reach subscription providers through the home proxy only.
      "src": ["tag:bifrost"],
      "dst": ["tag:proxy"],
      "ip": ["tcp:3128"]
    }
  ],
  "autoApprovers": {
    "services": { "svc:ai": ["tag:bifrost"] }
  },
  "nodeAttrs": [
    { "target": ["tag:bifrost"], "attr": ["funnel"] }
  ]
}
